# Copiá este archivo a `.env` y ajustá lo que necesites.
# Todos los valores tienen un default razonable: podés no crear el `.env` y funciona igual.

# --- Ollama ---
# Dónde escucha el servidor de Ollama. En Docker Compose se sobreescribe a http://ollama:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo de chat. llama3.2:3b (~2 GB) anda en notebooks sin GPU.
# Si tenés más RAM/VRAM, llama3.1:8b da mejores respuestas.
CHAT_MODEL=llama3.2:3b

# Modelo de embeddings para el retrieval (~275 MB).
EMBEDDING_MODEL=nomic-embed-text

# Temperatura de generación. Baja a propósito: la tarea es reproducir datos del
# catálogo, no redactar con creatividad. Subila si querés respuestas más sueltas,
# a costa de que varíen más entre corridas.
TEMPERATURE=0.2

# --- RAG ---
# Cantidad de documentos que se le pasan al modelo como contexto.
TOP_K=5

# Piso de similitud coseno para incluir un documento en el contexto (0.0 a 1.0).
# Recorta las coincidencias flojas de cada búsqueda; no filtra preguntas fuera de
# tema (de eso se encarga el prompt). Subilo si el bot trae datos de más.
SIMILARITY_THRESHOLD=0.55

# --- Conversación ---
# Turnos de conversación que recuerda cada sesión.
MAX_HISTORY_TURNS=10

# Segundos de inactividad antes de descartar una sesión.
SESSION_TTL_SECONDS=3600

# --- API ---
# Orígenes permitidos por CORS, separados por coma. El frontend se sirve desde
# el mismo origen que la API, así que normalmente no hace falta tocarlo.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
